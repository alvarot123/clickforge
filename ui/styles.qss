QWidget {
    color: #f4f7fb;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget#Root, QScrollArea {
    background: #0f0f13;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QFrame#Card {
    background: #1a1a24;
    border: 1px solid #2a2a3a;
    border-radius: 18px;
}

QLabel {
    background: transparent;
}

QLabel#Title {
    font-size: 23px;
    font-weight: 700;
    color: #ffffff;
    min-height: 34px;
}

QLabel#Subtitle {
    color: #8e94ad;
    font-size: 12px;
}

QLabel#SectionTitle {
    color: #c9d2ea;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QLabel#ValueLabel, QLabel#CounterValue, QLabel#RealtimeCps {
    font-family: "JetBrains Mono", "Consolas", monospace;
}

QLabel#CounterValue {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    min-height: 40px;
}

QLabel#RealtimeCps {
    color: #22d3ee;
    font-size: 12px;
}

QLabel#StatusText {
    font-weight: 700;
    color: #dce4f7;
}

QLabel#StatusDot {
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    border-radius: 6px;
    background: #6b7280;
}

QLabel[statusState="running"]#StatusDot {
    background: #22d3ee;
    border: 1px solid rgba(34, 211, 238, 0.45);
}

QLabel[statusState="idle"]#StatusDot {
    background: #6b7280;
}

QLabel[statusState="error"]#StatusDot {
    background: #ef4444;
}

QPushButton {
    background: #222333;
    color: #f4f7fb;
    border: 1px solid #34384f;
    border-radius: 14px;
    padding: 9px 14px;
    font-weight: 700;
}

QPushButton:hover {
    border-color: #5f68b8;
    background: #292b3f;
}

QPushButton:pressed {
    background: #1b1d2a;
}

QPushButton#PrimaryButton {
    background: #21384b;
    border: 1px solid #22d3ee;
    color: #e6fbff;
    font-size: 16px;
    min-height: 52px;
    border-radius: 20px;
    padding: 12px 18px;
}

QPushButton#PrimaryButton[running="false"]:hover {
    background: #29506b;
}

QPushButton#PrimaryButton[running="true"] {
    background: #4e212d;
    border: 1px solid #ef4444;
    color: #fff1f2;
}

QPushButton#PrimaryButton[running="true"]:hover {
    background: #642636;
}

QPushButton#IconButton {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 19px;
    padding: 0;
    font-size: 12px;
}

QPushButton#CaptureButton, QPushButton#RecordButton {
    min-height: 42px;
    border-radius: 15px;
    background: #262743;
    border: 1px solid #3f4470;
    padding: 9px 16px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #12121a;
    color: #ffffff;
    border: none;
    border-bottom: 1px solid #38384c;
    border-radius: 0;
    min-height: 36px;
    padding: 9px 4px;
    selection-background-color: #6366f1;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-bottom: 1px solid #22d3ee;
}

QComboBox {
    padding-right: 20px;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    border: none;
    background: transparent;
    width: 16px;
}

QRadioButton, QCheckBox {
    spacing: 8px;
    color: #dce4f7;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator {
    border-radius: 8px;
    border: 1px solid #4b5563;
    background: #11131a;
}

QRadioButton::indicator:checked {
    border: 1px solid #22d3ee;
    background: #22d3ee;
}

QCheckBox::indicator {
    border-radius: 4px;
    border: 1px solid #4b5563;
    background: #11131a;
}

QCheckBox::indicator:checked {
    background: #6366f1;
    border: 1px solid #818cf8;
}

QScrollArea, QListWidget {
    background: #12121a;
    border: 1px solid #2a2a3a;
    border-radius: 12px;
}

QScrollArea {
    border: none;
}

QListWidget {
    padding: 6px;
}

QListWidget::item {
    border-bottom: 1px solid #20202a;
    padding: 7px 4px;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #2f3652;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QLabel#Badge {
    background: rgba(79, 70, 229, 0.18);
    color: #d7ddff;
    border: 1px solid rgba(99, 102, 241, 0.52);
    border-radius: 14px;
    padding: 8px 12px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-weight: 700;
}

QLabel#Muted {
    color: #8e94ad;
    font-size: 12px;
}

QWidget[theme="light"] {
    background: #f4f7fb;
    color: #12131a;
}

QWidget[theme="light"] QLabel#Title,
QWidget[theme="light"] QLabel#CounterValue,
QWidget[theme="light"] QLabel#StatusText {
    color: #111827;
}

QWidget[theme="light"] QFrame#Card {
    background: #ffffff;
    border: 1px solid #d8dfef;
}

QWidget[theme="light"] QLabel#SectionTitle {
    color: #475467;
}

QWidget[theme="light"] QLabel#Subtitle,
QWidget[theme="light"] QLabel#Muted {
    color: #667085;
}

QWidget[theme="light"] QRadioButton,
QWidget[theme="light"] QCheckBox {
    color: #1f2937;
}

QWidget[theme="light"] QLabel#RealtimeCps {
    color: #0891b2;
}

QWidget[theme="light"] QLineEdit,
QWidget[theme="light"] QSpinBox,
QWidget[theme="light"] QDoubleSpinBox,
QWidget[theme="light"] QComboBox,
QWidget[theme="light"] QListWidget {
    background: #f8fafc;
    color: #111827;
    border-bottom: 1px solid #d0d7e7;
}

QWidget[theme="light"] QListWidget {
    border: 1px solid #d8dfef;
}

QWidget[theme="light"] QPushButton {
    background: #eef2ff;
    color: #1f2937;
    border: 1px solid #c7d2fe;
}

QWidget[theme="light"] QPushButton:hover {
    background: #e0e7ff;
}

QWidget[theme="light"] QPushButton#IconButton {
    background: #eef2ff;
    color: #312e81;
    border: 1px solid #c7d2fe;
}

QWidget[theme="light"] QPushButton#CaptureButton,
QWidget[theme="light"] QPushButton#RecordButton {
    background: #e7edff;
    color: #1f2a44;
    border: 1px solid #becbff;
}

QWidget[theme="light"] QPushButton#PrimaryButton {
    background: #0f766e;
    color: #ecfeff;
    border: 1px solid #14b8a6;
}

QWidget[theme="light"] QPushButton#PrimaryButton[running="true"] {
    background: #b91c1c;
    color: #fef2f2;
    border: 1px solid #ef4444;
}

QWidget[theme="light"] QLabel#Badge {
    background: #eef2ff;
    color: #312e81;
    border: 1px solid #c7d2fe;
}
